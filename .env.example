# GameLink Agent — example environment configuration.
# Copy to `.env` and fill in real values. `.env` is gitignored.

# ---- LLM provider (OpenAI-compatible endpoint) ----
# Works with OpenAI, DeepSeek, Moonshot, local vLLM/Ollama, etc.
GAMELINK_LLM_BASE_URL=https://api.openai.com/v1
GAMELINK_LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
GAMELINK_LLM_MODEL=gpt-4o-mini
GAMELINK_LLM_TEMPERATURE=0

# ---- Godot engine ----
# Path to the Godot 4.x executable used for headless introspection / export.
# Use the *_console.exe build on Windows so headless output is captured.
# This machine: Godot 4.7.2 lives at C:/D/GodotEngine
GAMELINK_GODOT_BIN=C:/D/GodotEngine/Godot_v4.7.2-stable_win64_console.exe

# ---- Deployment target: Windows cloud server ----
GAMELINK_DEPLOY_HOST=203.0.113.10
GAMELINK_DEPLOY_USER=Administrator
GAMELINK_DEPLOY_SSH_PORT=22
# Path to a private key accepted by the server (optional; password auth unsupported).
GAMELINK_DEPLOY_KEY=C:/Users/you/.ssh/id_ed25519
# Remote directory where server builds are uploaded.
GAMELINK_DEPLOY_REMOTE_DIR=C:/GameLink/server
# UDP port the Godot headless server listens on (ENet).
GAMELINK_DEPLOY_GAME_PORT=7000
