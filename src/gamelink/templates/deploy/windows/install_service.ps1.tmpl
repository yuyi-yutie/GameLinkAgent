<#
.SYNOPSIS
  把 GameLink 导出的服务端注册为 Windows 服务（用 NSSM 实现开机自启 + 崩溃重启）。

.DESCRIPTION
  需要先安装 NSSM（https://nssm.cc/）并把它加入 PATH。

.EXAMPLE
  .\install_service.ps1 -ServerExe C:\GameLink\{{ slug }}\{{ exe_name }} -Port {{ port }}
#>
param(
    [Parameter(Mandatory = $true)][string]$ServerExe,
    [int]$Port = {{ port }},
    [string]$ServiceName = "{{ service_name }}",
    [string]$LogDir = "C:\GameLink\logs"
)

$ErrorActionPreference = "Stop"

$nssm = (Get-Command nssm.exe -ErrorAction SilentlyContinue).Source
if (-not $nssm) {
    throw "未找到 nssm.exe，请先从 https://nssm.cc/ 下载并加入 PATH。"
}
if (-not (Test-Path $ServerExe)) {
    throw "服务端程序不存在：$ServerExe"
}
New-Item -ItemType Directory -Force -Path $LogDir | Out-Null

if (Get-Service -Name $ServiceName -ErrorAction SilentlyContinue) {
    Write-Host "已存在同名服务，先停止并删除：$ServiceName"
    & $nssm stop $ServiceName | Out-Null
    & $nssm remove $ServiceName confirm | Out-Null
}

& $nssm install $ServiceName $ServerExe "--headless" "--server" "--port" $Port
& $nssm set $ServiceName AppStdout (Join-Path $LogDir "server.log")
& $nssm set $ServiceName AppStderr (Join-Path $LogDir "server.err.log")
& $nssm set $ServiceName Start SERVICE_AUTO_START
& $nssm start $ServiceName

Write-Host "服务 '$ServiceName' 已安装并启动（UDP $Port）。"
